# Copy this file to .env and fill in real values for LOCAL DEVELOPMENT.
# On Railway/LangGraph Platform, set these as deployment env vars/secrets
# instead - .env is not used in production, only by `python main.py`,
# `uvicorn app:app`, or `langgraph dev` run locally.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# If set (non-empty), this OVERRIDES client_config.csv's base_url column
# for every client. Leave empty to let the CSV / per-client value win.
BOOKING_API_BASE_URL=
BOOKING_API_TIMEOUT_SECONDS=15

OTP_PROVIDER=dummy
AUTHENTICA_API_KEY=
AUTHENTICA_BASE_URL=http://api.authentica.sa/api/v2
AUTHENTICA_TEMPLATE_ID=31
AUTHENTICA_FALLBACK_EMAIL=

DEFAULT_COUNTRY_CODE=20
AGENT_DATA_DIR=
LOG_LEVEL=INFO

# Set automatically by Railway - do not set manually for deployment.
PORT=8000
